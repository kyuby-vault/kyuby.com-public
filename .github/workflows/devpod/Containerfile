# Node 22.x: Cloudflare Pages build compatibility without freezing patch updates.
# Each rebuilt image is validated by the smoke checks and full DevPod gates.
FROM docker.io/library/node:22-bookworm-slim
LABEL com.kyuby.devpod="true"
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    WRANGLER_SEND_METRICS=false ASTRO_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_CACHE=/opt/npm-cache KYUBY_DEVPOD=1
RUN apt-get update && apt-get install -y --no-install-recommends git bash curl jq ca-certificates make \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1001 appuser && useradd --uid 1001 --gid 1001 --create-home appuser
WORKDIR /workspace
COPY package.json package-lock.json .nvmrc ./
# No blanket postinstall execution: esbuild/workerd/sharp platform binaries arrive
# as locked optional packages; onnxruntime-node is not used by browser inference.
# Playwright's browser/system install is the sole explicit installer below.
RUN npm ci --ignore-scripts \
    && npx --no-install playwright install --with-deps chromium \
    && sha256sum package-lock.json | cut -d ' ' -f1 > /opt/kyuby-lock-sha \
    && cp /opt/kyuby-lock-sha node_modules/.kyuby-lock-sha \
    && rm -rf /var/lib/apt/lists/*
COPY .github/workflows/devpod/ /opt/kyuby-devpod/
COPY .github/workflows/devpod/Makefile /workspace/Makefile
RUN mkdir -p /workspace/.astro /workspace/dist /workspace/test-results /workspace/.wrangler \
    && chown -R appuser:appuser /workspace /opt/npm-cache \
    && chmod -R a+rX /opt/pw-browsers /opt/kyuby-devpod
USER appuser
ENTRYPOINT ["bash", "/opt/kyuby-devpod/entrypoint.sh"]
CMD ["make", "-C", "/workspace", "gates"]
# Build-ending smoke gate: Node major only; Playwright/Wrangler stay exact and lockfile-owned.
RUN test "$(node -p 'process.versions.node.split(".")[0]')" = 22 \
    && test "$(npx --no-install playwright --version)" = "Version $(node -p 'require("./package.json").devDependencies["@playwright/test"]')" \
    && test "$(npx --no-install wrangler --version)" = "$(node -p 'require("./package-lock.json").packages["node_modules/wrangler"].version')"
